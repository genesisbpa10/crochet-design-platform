// Esquema de datos del prototipo. Corresponde al diagrama entidad-relación (Figura 9) del TFG.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Usuario {
  idUsuario      Int          @id @default(autoincrement()) @map("id_usuario")
  nombre         String @db.VarChar(100)
  correo         String @db.VarChar(254)       @unique
  contrasenaHash String       @map("contrasena_hash") @db.VarChar(255)
  rol            String @db.VarChar(20)
  motivos        Motivo[]
  propuestas     Propuesta[]
  evaluaciones   Evaluacion[]

  @@map("usuario")
}

model Motivo {
  idMotivo          Int           @id @default(autoincrement()) @map("id_motivo")
  idUsuario         Int           @map("id_usuario")
  nombre            String @db.VarChar(80)
  ancho             Int
  alto              Int
  grilla            Json
  fechaCreacion     DateTime      @default(now()) @map("fecha_creacion")
  fechaModificacion DateTime      @updatedAt @map("fecha_modificacion")
  usuario           Usuario       @relation(fields: [idUsuario], references: [idUsuario])
  colores           ColorMotivo[]
  propuestas        Propuesta[]

  @@index([idUsuario])
  @@map("motivo")
}

model ColorMotivo {
  idColor    Int            @id @default(autoincrement()) @map("id_color")
  idMotivo   Int            @map("id_motivo")
  nombre     String @db.VarChar(40)
  codigoHex  String         @map("codigo_hex") @db.VarChar(7)
  motivo     Motivo         @relation(fields: [idMotivo], references: [idMotivo], onDelete: Cascade)
  detalles   DetalleColor[]

  @@index([idMotivo])
  @@map("color_motivo")
}

model Propuesta {
  idPropuesta Int            @id @default(autoincrement()) @map("id_propuesta")
  idMotivo    Int            @map("id_motivo")
  idCliente   Int            @map("id_cliente")
  descripcion String
  estado      String @db.VarChar(20)
  totalPuntos Int            @map("total_puntos")
  fechaEnvio  DateTime       @default(now()) @map("fecha_envio")
  motivo      Motivo         @relation(fields: [idMotivo], references: [idMotivo])
  cliente     Usuario        @relation(fields: [idCliente], references: [idUsuario])
  detalles    DetalleColor[]
  presupuesto Presupuesto?
  evaluacion  Evaluacion?

  @@index([idCliente])
  @@index([estado])
  @@map("propuesta")
}

model DetalleColor {
  idDetalle   Int         @id @default(autoincrement()) @map("id_detalle")
  idPropuesta Int         @map("id_propuesta")
  idColor     Int         @map("id_color")
  puntos      Int
  metrosHilo  Decimal     @map("metros_hilo") @db.Decimal(10, 2)
  propuesta   Propuesta   @relation(fields: [idPropuesta], references: [idPropuesta], onDelete: Cascade)
  color       ColorMotivo @relation(fields: [idColor], references: [idColor])

  @@index([idPropuesta])
  @@map("detalle_color")
}

model Presupuesto {
  idPresupuesto Int       @id @default(autoincrement()) @map("id_presupuesto")
  idPropuesta   Int       @unique @map("id_propuesta")
  monto         Decimal   @db.Decimal(12, 2)
  observaciones String?
  fecha         DateTime  @default(now())
  propuesta     Propuesta @relation(fields: [idPropuesta], references: [idPropuesta], onDelete: Cascade)

  @@map("presupuesto")
}

model Evaluacion {
  idEvaluacion  Int       @id @default(autoincrement()) @map("id_evaluacion")
  idPropuesta   Int       @unique @map("id_propuesta")
  idArtesana    Int       @map("id_artesana")
  resultado     String @db.VarChar(30)
  observaciones String?
  fecha         DateTime  @default(now())
  propuesta     Propuesta @relation(fields: [idPropuesta], references: [idPropuesta], onDelete: Cascade)
  artesana      Usuario   @relation(fields: [idArtesana], references: [idUsuario])
  ajustes       Ajuste[]

  @@map("evaluacion")
}

model Ajuste {
  idAjuste     Int        @id @default(autoincrement()) @map("id_ajuste")
  idEvaluacion Int        @map("id_evaluacion")
  descripcion  String
  evaluacion   Evaluacion @relation(fields: [idEvaluacion], references: [idEvaluacion], onDelete: Cascade)

  @@index([idEvaluacion])
  @@map("ajuste")
}
