# Copiá este archivo como .env y completá los valores. No subas .env al repositorio.

# Base de datos PostgreSQL (por ejemplo, Neon).
# DATABASE_URL: conexión con pooler (la usa la aplicación).
# DIRECT_URL: conexión directa, sin pooler (la usa Prisma para crear las tablas).
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST-pooler/BASE?sslmode=require"
DIRECT_URL="postgresql://USUARIO:CONTRASENA@HOST/BASE?sslmode=require"

# Secreto para firmar la sesión (mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Cuenta de la artesana, creada con "npm run db:seed" (la contraseña debe tener al menos 12 caracteres).
ARTESANA_NOMBRE="Artesana"
ARTESANA_EMAIL="artesana@ejemplo.com"
ARTESANA_PASSWORD=""
